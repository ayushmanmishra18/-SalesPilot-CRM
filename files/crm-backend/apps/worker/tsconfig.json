{
  "compilerOptions": {
    "target":          "ES2020",
    "module":          "commonjs",
    "outDir":          "./dist",
    "rootDir":         "./src",
    "strict":          true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "baseUrl":         ".",
    "paths": {
      "@crm/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
