# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/crm

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# JWT — both required; the app refuses to start without them (no hardcoded fallback).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Super Admin seed (created on first boot if none exists)
SUPER_ADMIN_EMAIL=superadmin@crm.internal
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Google OAuth (for Sign-In with Google)
GOOGLE_CLIENT_ID=your-google-client-id

# Google OAuth (for Gmail send — different scope)
GOOGLE_GMAIL_CLIENT_ID=your-gmail-client-id
GOOGLE_GMAIL_CLIENT_SECRET=your-gmail-client-secret
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:5173/settings

# Email (transactional — invite links, lead notifications). Sent via Resend's HTTPS
# API, not SMTP — hosts like Render commonly block outbound SMTP ports, so plain
# SMTP (Gmail, Mailgun SMTP, etc.) cannot be relied on from a cloud deploy. Get a
# key from resend.com -> API Keys. Leaving this blank just logs instead of sending.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=SalesPilot CRM <no-reply@yourdomain.com>
