# Backend API URL
VITE_API_URL=http://localhost:3001

# Google Sign-In (optional)
# Get from: console.cloud.google.com → OAuth 2.0 Client ID (Web application)
# Add Authorized JavaScript Origins: http://localhost:5173 + your prod domain
VITE_GOOGLE_CLIENT_ID=

# Microsoft Sign-In (optional)
# Get from: portal.azure.com → App registrations
VITE_MICROSOFT_CLIENT_ID=
